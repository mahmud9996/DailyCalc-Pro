# Public site URL (no trailing slash) — used for canonical URLs, sitemap, schema
NEXT_PUBLIC_SITE_URL=https://www.dailycalcpro.com

# Google AdSense publisher ID — get this from adsense.google.com after approval
# Format: ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-0000000000000000

# Individual ad unit slot IDs (create these inside your AdSense dashboard)
NEXT_PUBLIC_AD_SLOT_TOP=1111111111
NEXT_PUBLIC_AD_SLOT_AFTER_RESULT=2222222222
NEXT_PUBLIC_AD_SLOT_MID_CONTENT=3333333333
NEXT_PUBLIC_AD_SLOT_FAQ=4444444444
NEXT_PUBLIC_AD_SLOT_FOOTER=5555555555
NEXT_PUBLIC_AD_SLOT_STICKY=6666666666

# Google Search Console verification (optional)
NEXT_PUBLIC_GSC_VERIFICATION=

# Future: Firebase (leave blank until Auth/DB is added)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
